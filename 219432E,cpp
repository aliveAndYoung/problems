#include <bits/stdc++.h>
using namespace std;
int main()
{
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    long long n, curr, max = -0x7FFFFFFFFFFFFFFF;
    cin >> n;
    while (n--)
    {
        cin >> curr;
        curr > max && (max = curr);
    }
    cout << max;
    return 0;
}